# ====================================================================
# SynapseRAG Configuration Template
# Copy this file to .env and fill in your values
# ====================================================================

# Cloud LLM API Keys (Optional if running 100% Local AI with Ollama)
OPENAI_API_KEY=
TAVILY_API_KEY=

# Local AI Engine Settings (Auto-detected if Ollama/LM Studio is running)
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
LM_STUDIO_HOST=http://localhost:1234
# LOCAL_LLM_URL=http://localhost:8000/v1

# Security & Authentication Gateway
JWT_SECRET=synapse_rag_super_secret_jwt_key_2026_change_in_production
AUTH_SERVICE_PORT=8080
PYTHON_RAG_URL=http://localhost:8000/rag/query

# Persistence & Storage
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=synapse_rag
FAISS_INDEX_DIR=faiss_index
DOCUMENTS_CATALOG_PATH=documents_catalog.json
